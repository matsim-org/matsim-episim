# Copy this file to .env and replace the SVN URLs and credentials path.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_FERNET_KEY=Cnj1WkOZbK2uL-h-u3OaSH_fOp2mm5dVAZVx8ajFAOI=
AIRFLOW_JWT_SECRET=local-poc-only-change-me
AIRFLOW_WORKER_CONCURRENCY=1

# The Docker daemon sees its own socket at /var/run/docker.sock in Docker Desktop and Colima.
DOCKER_SOCKET=/var/run/docker.sock
# Numeric group owning the daemon socket. With Colima, get it using:
# colima ssh -- stat -c '%g' /var/run/docker.sock
DOCKER_GID=0

EPISIM_RUNNER_IMAGE=episim-runner:poc
EPISIM_CREDENTIALS_DIR=/Users/your-user/.config/episim-runner
EPISIM_SOURCE_SVN_URL=https://svn.example.org/repos/episim/results/airflow-poc
EPISIM_TARGET_SVN_URL=https://svn.example.org/repos/episim/visualizations
EPISIM_MAX_PARALLEL=1
EPISIM_RUN_MEMORY=8g
EPISIM_RUN_CPUS=1
